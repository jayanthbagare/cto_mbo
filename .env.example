# Copy to .env for local runs. Never commit a real .env.

# mock | odata
DATA_SOURCE=mock

# recorded | live | template
LLM_MODE=recorded

# SAP AI Core (live mode only; injected at runtime in deployed environments)
AI_CORE_BASE_URL=
AI_CORE_CLIENT_ID=
AI_CORE_CLIENT_SECRET=
AI_CORE_MODEL=gpt-4o

# Frozen evaluation clock (ISO 8601). Determinism for tests and demos.
PROCESS_CLOCK=2026-01-15T08:00:00Z

# Synthetic corpus location
FIXTURES_DIR=fixtures/scenarios

# Portfolio scan window in days
PORTFOLIO_WINDOW_DAYS=365

# Live S/4HANA destination (odata mode only)
S4_BASE_URL=

# Server
PORT=8080
